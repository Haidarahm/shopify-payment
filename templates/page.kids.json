.product-block-options {display: none;}"],"settings":{"title":"","collection":"kids_flash","show_vendor":false,"enable_carousel":true,"grid":4,"rows":1,"color_scheme":"default","show_view_all":true,"view_all_position":"bottom","view_all_alignment":"center","target_user":"all","full_width":false}},"logo_list_HKQHPj":{"type":"logo-list","blocks":{"logo_BhFUt9":{"type":"logo","settings":{"image":"shopify:\/\/shop_images\/26_92c6b89e-9f42-4d5e-8d48-cb8041ac67fb.jpg","image_width":160,"link":"shopify:\/\/pages\/women","title":""}},"logo_8PkdFX":{"type":"logo","settings":{"image":"shopify:\/\/shop_images\/27_97585e70-354e-448c-9aee-09b480c65505.jpg","image_width":160,"link":"shopify:\/\/pages\/men","title":""}},"logo_9FRt9j":{"type":"logo","settings":{"image":"shopify:\/\/shop_images\/24_77200486-fa39-42bb-9c4f-99ad88cdc979.jpg","image_width":160,"link":"shopify:\/\/pages\/house","title":""}}},"block_order":["logo_BhFUt9","logo_8PkdFX","logo_9FRt9j"],"custom_css":[".logo-list__logo {max-width: 25%; margin-left: 3%; margin-right: 3%;}","@media (min-width: 786px) {.logo-list__logo-image {width: 130px; }}"],"settings":{"title":"Explore Other Sections","image_opacity":100,"color_scheme":"default"}},"rich_text_MccxN4":{"type":"rich-text","blocks":{"heading_fEGRyz":{"type":"heading","settings":{"title":"Shein Kids & Baby Fashion in Oman","use_h1":true}},"text_c4FPdT":{"type":"text","settings":{"text":"<p>Why wait weeks for children's clothes that might not even fit by the time they arrive? <\/p><p>Our Muscat warehouse is stocked with Shein kids' and baby essentials, delivered across Oman within 48 hours.<\/p><p>Cash on delivery  ·  Easy returns  ·  Outlet prices<\/p>","enlarge_text":false}}},"block_order":["heading_fEGRyz","text_c4FPdT"],"name":"Rich text","settings":{"height":"medium","text_alignment":"center","full_width":false,"color_scheme":"default"}},"collapsible_tabs_WkXN6D":{"type":"collapsible-tabs","blocks":{"question_tHtiwi":{"type":"question","settings":{"title":"Why Beisat is the Smartest Place to Shop Shein Kids' Fashion in Oman","answer":"<ul><li><strong>Stocked Locally:<\/strong> Every item is in our Muscat warehouse, no customs, no guessing when it will arrive<strong>.<br\/><br\/><\/strong><\/li><li><strong>48-Hour Delivery: <\/strong>Kids grow fast. Get what you need before the moment passes.<br\/><br\/><\/li><li><strong>Cash on Delivery: <\/strong>Pay on receipt, no cards, no stress.<br\/><br\/><\/li><li><strong>Outlet Prices: <\/strong>Shein's famous value, delivered at local speed.<\/li><\/ul>"}},"question_b33k7g":{"type":"question","settings":{"title":"The Right Way to Shop Shein Kids' Clothes in Oman","answer":"<p>Kids outgrow everything before you even get it out of the packaging. The last thing you need is a three-week shipping window on top of that. <\/p><p><a href=\"https:\/\/beisat.com\/?srsltid=AfmBOopWLY5C69KtikUmUl9Pp-4BGaYWLhgfUUigOUUfj8LmGkJrJp1I\"><span style=\"text-decoration:underline\">Beisat<\/span><\/a> is a Shein kids' outlet based right here in Muscat. We stock the items in bulk, hold them locally, and deliver to you while the size is still the right size. <\/p><p>From newborn essentials to school-age outfits to birthday party sets, it is all in our warehouse right now. <\/p><p>No tracking packages across five countries. No customs surprise. Just the cute, affordable children's fashion your family actually needs, delivered the same week you order it.<\/p>"}},"question_4iT8TF":{"type":"question","settings":{"title":"Shein Kids & Baby Collection at Beisat Oman","answer":"<p>Beisat carries the complete Shein range for younger customers: baby essentials, toddler outfits, kids' everyday wear, school clothes, pyjamas, activewear, swimwear, footwear, and accessories for boys and girls. <\/p><p>Everything is stocked in our Muscat warehouse and available for next-day or 48-hour delivery across Oman. As an outlet, many items are available in limited quantities, so popular sizes and styles sell out quickly. <\/p><p>We make shopping simple: filter by age group, browse by category, and check out in minutes. Cash on delivery, easy returns, and a smooth mobile experience mean less hassle for parents who already have enough on their plates. <\/p><p>If Shein makes it for kids or babies, there is a very good chance it is already sitting in our warehouse in Oman, ready for your doorstep in 48 hours or less.<\/p>"}}},"block_order":["question_tHtiwi","question_b33k7g","question_4iT8TF"],"name":"Collapsible tabs","settings":{"title":"Read more"}}},"order":["main","rich_text_nzRTiM","rich_text_R3R6KM","slideshow_6cgEPc","countdown_timer_RxkbfU","collection_list_JQwBAA","collection_list_NVJ9ac","collection_list_4hX3bx","collection_list_wpc86h","countdown_timer_qcch3V","featured_collection_7rnW3B","featured_collection_grqymT","logo_list_HKQHPj","rich_text_MccxN4","collapsible_tabs_WkXN6D"]}